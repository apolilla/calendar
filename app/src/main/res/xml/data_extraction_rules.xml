<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules: back up the database and photos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="calendar.db" />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="calendar.db" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
